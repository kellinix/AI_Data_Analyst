# Only public mobile configuration belongs here. Never add a service-role key.
# Android emulator: http://10.0.2.2:8000
# Physical Android over USB with `adb reverse tcp:8000 tcp:8000`: http://127.0.0.1:8000
# Physical device: http://YOUR_COMPUTER_LAN_IP:8000 (same Wi-Fi)
# Release builds: use the deployed HTTPS backend.
EXPO_PUBLIC_API_URL=
# Optional browser-preview override, for example http://localhost:8000.
EXPO_PUBLIC_WEB_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional native application IDs; choose owned identifiers before store release.
ZEPHYR_ANDROID_PACKAGE=com.zephyr.analytics
ZEPHYR_IOS_BUNDLE_IDENTIFIER=com.zephyr.analytics
