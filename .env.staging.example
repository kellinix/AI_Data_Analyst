# Copy to an untracked staging environment file on the staging host.
# Keep the existing local .env unchanged. Do not commit filled credentials.
APP_ENV=staging
APP_NAME=Zephyr
SECRET_KEY=replace-with-unique-random-secret

# Railway assigns separate HTTPS hosts to the website and API on deployment.
# Replace these examples with those exact hosts before building the website.
NEXT_PUBLIC_APP_URL=https://web-staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com
BACKEND_CORS_ORIGINS=https://web-staging.example.com
FRONTEND_URL=https://web-staging.example.com

# New, separate Supabase project. Use this project's own keys only.
NEXT_PUBLIC_SUPABASE_URL=https://fpeeofqwylhxyglttlrg.supabase.co
SUPABASE_URL=https://fpeeofqwylhxyglttlrg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-this-project-browser-safe-anon-key
SUPABASE_ANON_KEY=replace-with-this-project-browser-safe-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-this-project-private-service-role-key

# For docker-compose.prod.yml, Postgres and Redis run inside Compose.
# URL-encode special characters in passwords used inside URLs.
POSTGRES_DB=zephyr_staging
POSTGRES_USER=zephyr_staging
POSTGRES_PASSWORD=replace-with-unique-database-password
DATABASE_URL=postgresql+asyncpg://zephyr_staging:replace-with-unique-database-password@postgres:5432/zephyr_staging
DATABASE_URL_SYNC=postgresql://zephyr_staging:replace-with-unique-database-password@postgres:5432/zephyr_staging
REDIS_PASSWORD=replace-with-unique-redis-password
REDIS_URL=redis://:replace-with-unique-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-unique-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-unique-redis-password@redis:6379/2

OPENAI_API_KEY=replace-with-backend-only-openai-key
DOCKER_REGISTRY=replace-with-container-registry
